meta {
  name: Aprueba la directora
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/solicitudes/{{compraId}}/decisiones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectora}}
}

body:json {
  {
    "tipo": "APROBAR",
    "comentario": "Visto bueno"
  }
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("queda en APROBADA", function() {
    expect(res.body.estado).to.equal("APROBADA");
  });
}
