meta {
  name: Cerrar (admin)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/solicitudes/{{compraId}}/cierre
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("queda en CERRADA", function() {
    expect(res.body.estado).to.equal("CERRADA");
  });
}
