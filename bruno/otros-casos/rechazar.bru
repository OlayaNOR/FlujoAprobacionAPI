meta {
  name: Rechazar con comentario
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/solicitudes/{{vacacionesId}}/decisiones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenJefe}}
}

body:json {
  {
    "tipo": "RECHAZAR",
    "comentario": "Ese mes cerramos el trimestre"
  }
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("queda en RECHAZADA", function() {
    expect(res.body.estado).to.equal("RECHAZADA");
  });
}
