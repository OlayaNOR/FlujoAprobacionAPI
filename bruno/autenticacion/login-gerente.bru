meta {
  name: Login gerente
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "gerente@flujos.test",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("tokenGerente", res.body.accessToken);
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
}
