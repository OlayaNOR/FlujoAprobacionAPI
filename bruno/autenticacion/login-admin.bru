meta {
  name: Login admin
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@flujos.test",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("tokenAdmin", res.body.accessToken);
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
}
